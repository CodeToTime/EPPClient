<configuration>
    <!-- Silence Logback's own status messages -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <!-- Use the -Deppclient.logLevel flag to change log level. Default is INFO -->
    <property name="LOG_LEVEL" value="${eppclient.logLevel:-INFO}"/>

    <!-- Console appender with readable format and log level highlighting -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %highlight([%-5level]) %cyan(%-36logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling file appender with daily rotation -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/eppclient.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/eppclient-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                </timestamp>
                <logLevel>
                    <fieldName>loglevel</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <arguments>
                    <includeNonStructuredArguments>false</includeNonStructuredArguments>
                </arguments>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <!-- Root logger uses the dynamic LOG_LEVEL property and both appenders -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
